<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_focused" />
            <corners android:radius="12dp" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_normal" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/tile_stroke" />
        </shape>
    </item>
</selector>

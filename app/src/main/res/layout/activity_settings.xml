<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:paddingStart="28dp"
    android:paddingTop="20dp"
    android:paddingEnd="28dp"
    android:paddingBottom="20dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/brand_green"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsTextSize"
            style="@style/MenuItem"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/settingsCursor"
            style="@style/MenuItem" />

        <TextView
            android:id="@+id/settingsPdfZoom"
            style="@style/MenuItem" />

        <TextView
            android:id="@+id/settingsPdfDirection"
            style="@style/MenuItem" />

        <TextView
            android:id="@+id/settingsClearCache"
            style="@style/MenuItem"
            android:layout_marginTop="22dp"
            android:text="@string/settings_clear_cache" />

        <TextView
            android:id="@+id/settingsClearHistory"
            style="@style/MenuItem"
            android:text="@string/settings_clear_history" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/settings_hint"
            android:textColor="@color/text_secondary"
            android:textSize="22sp" />

    </LinearLayout>

</ScrollView>
